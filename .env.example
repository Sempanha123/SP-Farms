SP_FARMS_ENV=development
SP_FARMS_LOG_LEVEL=INFO
SP_FARMS_DATABASE_URL=sqlite:///sp_farms.db

# Official Meta Graph API Credentials (Optional)
# If omitted, SP-Farms uses an in-memory test double (FakeMetaApiClient).
# Never commit real secrets. Use Windows Credential Manager or local .env.
SP_FARMS_META_APP_ID=
SP_FARMS_META_APP_SECRET=
SP_FARMS_META_REDIRECT_URI=https://localhost/oauth/callback
SP_FARMS_META_API_VERSION=v21.0

